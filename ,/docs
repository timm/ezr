#!/usr/bin/env bash
## [--ok]  rebuild any page whose source moved
# `out_of_date` (see ,/.needs) is all the dependency logic this
# project ever needed.
export PYTHONDONTWRITEBYTECODE=1   # py3.13 ignores the -B flag
Here=$(cd "$(dirname "$0")/.." && pwd); cd "$Here" || exit 1
. "$(dirname "$0")/.needs"
needs "$1" python3 pandoc etc/lit.py etc/manual.py etc/tut.html

for f in ezr ezr0 ezr0_eg ezr_eg; do
  out_of_date docs/$f.html $f.py etc/lit.py &&
    python3 -B etc/lit.py $f.py
done

out_of_date docs/manual.html ezr.py ezr_eg.py etc/manual.py &&
  python3 -B etc/manual.py

for m in docs/*.md; do
  h=${m%.md}.html
  case $m in */CHANGELOG.md|*/LICENSE.md|*/ezr.md) continue;; esac
  out_of_date "$h" "$m" etc/tut.html && pandoc -s \
     --syntax-highlighting=none --template=etc/tut.html \
     -M pagetitle="$(basename "${m%.md}")" -o "$h" "$m"
done

echo "docs up to date"
