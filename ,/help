#!/usr/bin/env bash
##  list these commands
# One `## <args>  <doc>` line per file is its whole manual: args,
# then two or more spaces, then what it does.  A new script shows
# up here the moment you write it.
Here=$(cd "$(dirname "$0")" && pwd)
printf '\nUsage:\n  ,/\033[36m<command>\033[0m [args]\n\ncommands:\n'
gawk 'FNR==1 { f = FILENAME; sub(/.*\//, "", f) }
      /^## / || /^##$/ {
        s = substr($0, 4)
        if (match(s, /  +/)) { a = substr(s, 1, RSTART-1)
                               d = substr(s, RSTART + RLENGTH) }
        else                 { a = ""; d = s }
        sub(/^ +/, "", d)
        printf("  \033[36m%-8s\033[0m %-21s %s\n", f, a, d) | "sort" }' \
  "$Here"/*
