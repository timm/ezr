#!/usr/bin/env bash
##  an interactive shell: prompt, history, aliases
# ,/sh -- the only command here that must change YOUR shell, so
# it is the only one you source.  Everything else in ,/ is an
# ordinary script.
#   ,/sh          an interactive shell with all of this loaded
#   . ,/sh        load it into the shell you are already in
#
# Executed, $0 == BASH_SOURCE[0], so we exec an interactive bash
# that reads THIS file as its init-file.  That re-entry sources
# us, making $0 "bash", so the guard is false and we do not
# loop.  Sourced from a live shell, the guard is false as well:
# no subshell, the definitions just land where you are.
# No args: become that shell.  With args: fall through, define
# everything, and run them from the last line of this file.
[ "$0" = "${BASH_SOURCE[0]}" ] && [ $# -eq 0 ] \
  && exec bash --init-file "$0" -i

# Here = the repo root (this file lives in ,/), so etc/ resolves
# even when you have cd'd somewhere else.
Here=$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)
PATH="$Here/,:$PATH"        # so `lint ezr` works, not just ,/lint

export EDITOR="nvim -u $Here/etc/nviminit.lua"
export BASH_SILENCE_DEPRECATION_WARNING=1
export PYTHONDONTWRITEBYTECODE=1  # py3.13 ignores the -B flag
export HISTSIZE=10000
export HISTFILESIZE=20000
export HISTCONTROL=ignoredups:erasedups
export LESS=-R                    # let git colors through

# histappend matters: without it, exiting a shell OVERWRITES
# .bash_history, so a second shell eats the first one's.
shopt -s histappend autocd cdspell dirspell globstar checkwinsize

# up-arrow walks only the lines starting with what you typed.
# Only an interactive shell has a line editor to bind to.
if [[ $- == *i* ]]; then
  bind '"\e[A": history-search-backward'
  bind '"\e[B": history-search-forward'
fi

ls()     { command ls --color "$@"; }
grep()   { command grep --color=auto "$@"; }
tree()   { command tree -C "$@"; }
eza()    { command eza --icons=always "$@"; }
col()    { command column -s, -t "$@"; }   # eyeball a csv
vi()     { $EDITOR "$@"; }                 # $EDITOR set above
tmux()   { command tmux -u -f "$Here/etc/tmux.rc" "$@"; }
branch() { git branch --show-current 2>/dev/null; }
dirty()  { [ -n "$(git status -s 2>/dev/null)" ] && echo "*"; }
root()   { cd "$Here"; }

# Leave these as raw escape codes
bold=$(tput bold)    ; plain=$(tput sgr0)
cyan=$(tput setaf 6) ; yellow=$(tput setaf 3)

# 🧩 parent/dir  branch*  ▶      \[ \] marks zero-width text,
# so bash still counts the line length right.
prompt_where='$(basename "$(dirname "$PWD")")/$(basename "$PWD")'
prompt_git='$(branch)$(dirty)'
prompt_fmt='🧩\[${bold}${cyan}\]'"$prompt_where"
prompt_fmt+='\[${plain}\] \[${yellow}\]'"$prompt_git"
prompt_fmt+='\[${plain}\] ▶ '
PROMPT_COMMAND='PS1="'"$prompt_fmt"'"'

# ./rc lint ezr  --  run one command and exit.  An `if` (not
# `&&`) so that sourcing this file still returns 0.
if [ "$0" = "${BASH_SOURCE[0]}" ] && [ $# -gt 0 ]; then "$@"; fi
